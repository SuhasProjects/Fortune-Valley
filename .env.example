# Server-side only. NEVER prefix with VITE_ (that would expose it to the browser).
AI_API_KEY=
# Anthropic model id used by the AI gateway. Default: claude-opus-5-5
AI_MODEL=claude-opus-5-5
# Set to "false" to force the offline fallback generators even if a key is present.
AI_ENABLED=true
# Request timeout for the upstream model call, ms
AI_TIMEOUT_MS=25000

# ── Alternative provider: any OpenAI-compatible chat-completions API ─────────
# AI_PROVIDER=openai_compatible
# AI_BASE_URL=https://router.luminal.cloud      # Luminal router (models: GET /v1/models)
# AI_MODEL=moonshotai/Kimi-K2.5
# AI_AUTH_HEADER=bearer                          # or api-key
