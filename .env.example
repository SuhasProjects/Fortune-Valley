# Server-side only. NEVER prefix with VITE_ (that would expose it to the browser).
# Default provider: Google Gemini. A bare GEMINI_API_KEY (from https://aistudio.google.com/apikey) selects
# AI_PROVIDER=openai_compatible, AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai, AI_MODEL=gemini-3.5-flash-lite.
GEMINI_API_KEY=
# Optional overrides (explicit AI_* always win). A bare LUMINAL_API_KEY instead selects Luminal's DeepSeek endpoint.
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_PROVIDER=openai_compatible
# Origin or full OpenAI-compatible prefix. `npm run dev` reads this file (server/aiDevMiddleware.ts); on Vercel set these as project env vars.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Set to "false" to force the offline fallback generators even if a key is present.
AI_ENABLED=true
# Request timeout for the upstream model call, ms
AI_TIMEOUT_MS=25000

# ── Alternative provider: any OpenAI-compatible chat-completions API ─────────
# AI_AUTH_HEADER=bearer                          # or api-key
