{
  "functions": {
    "api/ai.ts": {
      "maxDuration": 30
    }
  },
  "trailingSlash": false,
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "rewrites": [
    {
      "source": "/demo",
      "destination": "/index.html"
    }
  ]
}
